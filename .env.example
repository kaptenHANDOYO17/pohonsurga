# Salin file ini menjadi ".env.local" lalu isi nilainya.
# JANGAN commit .env.local ke GitHub.

# Supabase → Project Settings → API (atau "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon public" key ATAU "Publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-atau-publishable-key
# "service_role" key ATAU "Secret key" (sb_secret_...) — RAHASIA, hanya di server
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-atau-secret-key

# Kunci penanda tangan sesi login anggota (min. 32 karakter acak).
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# (Opsional tapi DISARANKAN) Kode akses keluarga yang dibagikan lewat grup WA.
# Jika diisi, anggota wajib memasukkan kode ini saat login (selain nama & tanggal lahir).
FAMILY_ACCESS_CODE=

# (Opsional) Judul website
NEXT_PUBLIC_SITE_TITLE=Bani H. Kholid Ismail Noer
NEXT_PUBLIC_SITE_SUBTITLE=Keluarga Besar Bapatua H. Syafi'i – Matua Juhairiyah
